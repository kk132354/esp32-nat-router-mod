# Routing + NAT (der C3 ist der Ausgang ins Internet)
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_IP4_FRAG=y
CONFIG_LWIP_IP4_REASSEMBLY=y

# WireGuard (x25519) braucht grosse Stacks
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=8192
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Etwas mehr Durchsatz
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32

CONFIG_WIFI_SSID="Redmi"
CONFIG_WIFI_PASSWORD="hahalustignicht"
CONFIG_WG_PRIVATE_KEY="TKOmtD6Pvf47ZgY89yYGo8Uw1IRMzPiP5QCgk9BV/gc="
CONFIG_WG_PEER_PUBLIC_KEY="weIiw56xqh3zXIUdaDfxepbiFYhEjTxH2WZ5ybLGpw4="
CONFIG_WG_PEER_ENDPOINT="kk132.duckdns.org"

CONFIG_LWIP_PPP_SUPPORT=y
