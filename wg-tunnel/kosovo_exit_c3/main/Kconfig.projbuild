menu "Kosovo Exit-Node (ESP32-C3)"

    config WIFI_SSID
        string "WLAN-Name (Router im Kosovo)"
        default "myssid"

    config WIFI_PASSWORD
        string "WLAN-Passwort"
        default ""

    config NTP_SERVER
        string "NTP-Server (WireGuard braucht korrekte Uhrzeit)"
        default "pool.ntp.org"

    config WG_PRIVATE_KEY
        string "Privater Schluessel dieses Geraets (base64)"
        default ""

    config WG_PEER_PUBLIC_KEY
        string "Oeffentlicher Schluessel des Deutschland-Gateways (base64)"
        default ""

    config WG_PRESHARED_KEY
        string "Optionaler Preshared Key (base64, leer = keiner)"
        default ""

    config WG_PEER_ENDPOINT
        string "DDNS-Name oder IP des Deutschland-Gateways"
        default "meinname.duckdns.org"

    config WG_PEER_PORT
        int "UDP-Port des Gateways (Portweiterleitung im deutschen Router)"
        default 51820

    config WG_LOCAL_PORT
        int "Lokaler UDP-Port"
        default 51820

    config WG_LOCAL_IP
        string "Tunnel-IP dieses Geraets"
        default "10.8.0.1"

    config WG_LOCAL_NETMASK
        string "Tunnel-Netzmaske"
        default "255.255.255.0"

    config WG_KEEPALIVE
        int "Persistent Keepalive in Sekunden (haelt NAT-Eintrag offen)"
        default 25

    config TUNNEL_DOWN_RESTART_S
        int "Neustart, wenn Tunnel so lange (s) nicht steht"
        default 180

endmenu

menu "Luefter (temperaturgesteuert)"

    config FAN_GPIO
        int "GPIO, der das Relais/den Transistor schaltet"
        default 4 if IDF_TARGET_ESP32C3
        default 26

    config FAN_ACTIVE_LOW
        bool "Ausgang schaltet bei LOW (nur fuer Relaismodule mit Low-Trigger; Transistor: aus)"
        default n

    config FAN_ON_TEMP_C
        int "Luefter AN ab (Grad C)"
        default 52

    config FAN_OFF_TEMP_C
        int "Luefter AUS bei (Grad C)"
        default 42

    config FAN_CHECK_S
        int "Messintervall in Sekunden"
        default 5

    config FAN_MIN_HOLD_S
        int "Mindestzeit zwischen zwei Schaltvorgaengen (s)"
        default 30


endmenu

menu "Webseite (Anmeldung, Gegenstelle)"

    config WEB_PEER_IP
        string "Tunnel-IP des ANDEREN Geraets (fuer /peer/)"
        default "10.8.0.2"

    config WEB_TRUST_AP
        bool "Geraete im eigenen SoftAP-WLAN sind vertraut (nur DevKit)"
        default n

    config WEB_TRUST_LAN
        bool "Geraete im Heimnetz (Router-WLAN) sind vertraut"
        default n

    config WEB_RESET_GPIO
        int "Taste, die 5 s gehalten das Passwort loescht (BOOT-Taste)"
        default 9 if IDF_TARGET_ESP32C3
        default 0

endmenu

menu "Firmware-Update (OTA)"

    config OTA_VERIFY_S
        int "Sekunden, bis eine neue Firmware den Tunnel haben muss (sonst Rollback)"
        default 300
        range 60 1800

endmenu
